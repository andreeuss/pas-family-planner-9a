{
  "id": "./",
  "name": "PAS Family Planner",
  "short_name": "PAS Family",
  "description": "Planeador semanal para familias del curso 9°A.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#0d7f8e",
  "background_color": "#eef5f6",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "pas_pdf", "accept": ["application/pdf"] }
      ]
    }
  }
}
